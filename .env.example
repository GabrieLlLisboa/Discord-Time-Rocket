# Token do bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Prefixo dos comandos de staff (!whitelist, !aprovar-whitelist, !reprovar-whitelist)
PREFIX=!

# Servidor de Minecraft (o bot só funciona nele)
GUILD_ID=1566899003520716960

# O !setupmine já preenche staff/membro sozinho (data/config.json). Os IDs abaixo são só reserva.
# --- IDs opcionais (clique direito > Copiar ID, com o modo desenvolvedor ligado) ---
# Cargo da staff que aprova/recusa whitelists (administradores sempre podem)
STAFF_ROLE_ID=
# Cargo "sem acesso" dado a quem entra e removido quando aprovado
NO_ACCESS_ROLE_ID=
# Cargo de membro dado quando a whitelist é aprovada
MEMBER_ROLE_ID=
# Canal onde chega uma cópia da whitelist pra staff aprovar/recusar
LOG_CHANNEL_ID=
# Categoria onde os canais de whitelist são criados (se vazio, o bot cria "🔒 Whitelist")
CATEGORY_ID=
